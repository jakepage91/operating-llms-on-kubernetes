        "version": "0.2.0",
        "configurations": [
          {
            "name": "Python Debugger: Gateway with mirrord",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/llm-gateway/app/main.py",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/llm-gateway/venv/bin/python",
            "cwd": "${workspaceFolder}/llm-gateway",
            "env": {
              "PYTHONPATH": "${workspaceFolder}/llm-gateway"
            }
          }
        ]
      }
    