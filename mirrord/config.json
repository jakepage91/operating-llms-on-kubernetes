{
  "target": {
    "namespace": "llm-gateway",
    "path": {
      "deployment": "llm-gateway"
    }
  },
  "feature": {
    "network": {
      "incoming": "mirror",
      "outgoing": {
        "tcp": true,
        "udp": true,
        "filter": {
          "local": [
            "tcp://127.0.0.1:*",
            "tcp://localhost:*"
          ]
        }
      },
      "dns": true
    },
    "fs": "local",
    "env": {
      "include": "OLLAMA_*;LLM_GATEWAY_*",
      "exclude": "HOME;USER;PATH"
    }
  },
  "operator": false
}
